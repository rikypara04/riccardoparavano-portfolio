---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
const areas = [
  ["01 / AI & Cybersecurity", "Intelligent and secure systems", "Exploring how AI, software engineering and cybersecurity principles can be combined in reliable solutions."],
  ["02 / Backend & Data", "Structured software and databases", "Designing backend functionality, relational data models and maintainable integrations."],
  ["03 / Web Platforms", "Useful digital experiences", "Building web platforms that support real users and practical organisational workflows."],
];
---
<BaseLayout><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Software Â· AI Â· Cybersecurity</p><h1>Designing reliable systems with <span class="accent">care and curiosity.</span></h1><p class="lead">I am Riccardo Paravano, a Computer Science graduate and MSc student in Artificial Intelligence and Cybersecurity. I turn complex requirements into well-designed software and web solutions.</p><div class="button-row"><a class="button button--primary" href={withBase("/projects/")}>Explore my work</a><a class="button" href={withBase("/about/")}>More about me</a></div></div><aside class="panel"><p class="eyebrow">Current focus</p><p><b>MSc in AI & Cybersecurity</b><br />Udine, Italy</p><p>Software, data and web platforms</p><p>Precise, methodical and creative</p></aside></div></section><section class="section"><div class="container"><p class="eyebrow">Technical direction</p><h2>Where I create value</h2><div class="grid grid--three">{areas.map((area) => <article class="card"><p class="card__label">{area[0]}</p><h3>{area[1]}</h3><p class="card__text">{area[2]}</p></article>)}</div></div></section><section class="section"><div class="container callout"><div><p class="eyebrow">Selected work</p><h2>Experience through real projects.</h2></div><a class="button button--primary" href={withBase("/projects/")}>View projects</a></div></section></BaseLayout>
<style>
.hero { display: grid; min-height: calc(100vh - 4.75rem); align-items: center; padding: 5rem 0; }.hero-grid { display: grid; grid-template-columns: 1.5fr .65fr; align-items: center; gap: clamp(2rem,7vw,7rem); }.panel,.callout { padding: clamp(1.5rem,4vw,3rem); border: 1px solid var(--border); border-radius: 1.5rem; background: var(--surface); }.panel p { color: var(--muted); }.panel b { color: var(--text); }.callout { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }.callout h2 { margin: 0; }@media (max-width:820px){.hero-grid{grid-template-columns:1fr}.callout{align-items:start;flex-direction:column}}
</style>