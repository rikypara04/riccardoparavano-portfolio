---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
import { siteConfig } from "../config/site";

const areas = [
  {
    number: "01 / Software engineering",
    title: "From requirements to working software",
    text: "Experience translating functional requirements into application logic, database structures and integrated features.",
  },
  {
    number: "02 / Backend and data",
    title: "Structured systems and reliable data",
    text: "Relational modelling, PostgreSQL, SQL and backend development for applications with real operational constraints.",
  },
  {
    number: "03 / Web platforms",
    title: "Digital services for real users",
    text: "Building and maintaining web experiences, from institutional communication to authenticated workflows.",
  },
];
---
<BaseLayout
  title="Riccardo Paravano | Software Developer"
  description="Computer Science graduate and MSc student in Cyber Security and Artificial Intelligence. Explore Riccardo Paravano's software, database and web-platform projects."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Software development · Backend · Data · Web</p>
        <h1>Building software for <span class="accent">real-world problems.</span></h1>
        <p class="lead">
          I am Riccardo Paravano, a Computer Science graduate from the University of Udine and currently an MSc student in Cyber Security and Artificial Intelligence. I have practical experience developing an enterprise maintenance module and building web services for a local organisation. I enjoy turning requirements into clear, maintainable software.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/projects/")}>Explore my work</a>
          <a class="button" href={withBase(siteConfig.cvPath)} download>Download CV</a>
          <a class="text-link" href={withBase("/about/")}>About me</a>
        </div>
      </div>
      <aside class="panel" aria-label="Current professional profile">
        <img
          class="profile-photo"
          src={withBase("/images/riccardo-profile.jpg")}
          alt="Portrait of Riccardo Paravano"
          width="800"
          height="800"
          loading="eager"
        />
        <span class="availability">Open to entry-level opportunities</span>
        <p class="eyebrow">At a glance</p>
        <dl>
          <div><dt>Education</dt><dd>BSc in Computer Science</dd></div>
          <div><dt>Currently studying</dt><dd>MSc in Cyber Security and Artificial Intelligence</dd></div>
          <div><dt>Professional experience</dt><dd>Software Developer Intern · PAT / Zucchetti Group</dd></div>
          <div><dt>Based in</dt><dd>Udine, Italy</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What I work on</p>
      <h2>Where I can contribute</h2>
      <div class="grid grid--three">
        {areas.map((area) => (
          <article class="card">
            <p class="card__label">{area.number}</p>
            <h3>{area.title}</h3>
            <p class="card__text">{area.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section selected-section">
    <div class="container">
      <div class="selected-heading">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Two projects, two different engineering contexts.</h2>
          <p class="section-intro">One enterprise subsystem developed during my internship, and one web platform built around the needs of a real association.</p>
        </div>
        <a class="text-link" href={withBase("/projects/")}>All projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="selected-grid">
        <a class="selected-card" href={withBase("/projects/predictive-maintenance/")}>
          <span>Enterprise software · PAT Srl</span>
          <h3>Threshold-Based Maintenance for openMAINT</h3>
          <p>Database modelling, backend logic and threshold evaluation to transform technical readings into traceable maintenance events.</p>
          <span class="card-cta">Read case study <span aria-hidden="true">→</span></span>
        </a>
        <a class="selected-card" href={withBase("/projects/aia-udine/")}>
          <span>Web platform · AIA Udine</span>
          <h3>AIA Udine Web Platform</h3>
          <p>Institutional communication and member services through a customised WordPress platform and supporting workflows.</p>
          <span class="card-cta">Read case study <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; min-height: calc(100svh - 4.75rem); align-items: center; padding: clamp(4rem, 8vw, 7rem) 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(19rem, .65fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  .panel { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border); border-radius: 1.5rem; background: linear-gradient(145deg, rgba(142,197,244,.055), transparent 42%), var(--surface); box-shadow: 0 24px 70px rgba(0,0,0,.24); }
  .profile-photo { width: 9rem; height: 9rem; margin-bottom: 1.5rem; border: 1px solid var(--border); border-radius: 1.3rem; object-fit: cover; object-position: center; background: var(--surface); }
  .availability { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 1.7rem; color: #9ce7bd; font-size: .72rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .availability::before { width: .55rem; height: .55rem; border-radius: 50%; background: #5ee0a0; box-shadow: 0 0 0 .3rem rgba(94,224,160,.12); content: ""; }
  dl, dd { margin: 0; } dl { display: grid; gap: 1.15rem; } dl div { padding-bottom: 1.05rem; border-bottom: 1px solid var(--border); } dl div:last-child { padding-bottom: 0; border-bottom: 0; }
  dt { margin-bottom: .2rem; color: var(--muted); font-size: .78rem; } dd { font-weight: 720; }
  .selected-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .selected-heading h2 { max-width: 19ch; margin: 0; }
  .section-intro { max-width: 62ch; margin: 1rem 0 0; color: var(--muted); }
  .selected-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .selected-card { display: flex; min-height: 19rem; flex-direction: column; align-items: flex-start; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--border); border-radius: 1.2rem; background: var(--surface); text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .selected-card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .selected-card > span:first-child { color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .selected-card h3 { margin-top: 1.2rem; font-size: 1.65rem; }
  .selected-card p { margin-bottom: 1.5rem; color: var(--muted); }
  .card-cta { margin-top: auto; color: var(--accent); font-weight: 800; }
  .text-link { display: inline-flex; min-height: 3rem; align-items: center; gap: .35rem; padding-inline: .35rem; color: var(--muted); font-weight: 750; text-underline-offset: .3rem; }
  .text-link:hover { color: var(--accent); }
  @media (max-width: 920px) { .hero-grid { grid-template-columns: 1fr; } .panel { max-width: 38rem; } }
  @media (max-width: 820px) { .selected-heading { align-items: flex-start; flex-direction: column; } .selected-grid { grid-template-columns: 1fr; } }
</style>
