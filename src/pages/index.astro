---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
import { siteConfig } from "../config/site";
const areas = [
  ["01 / AI & Cybersecurity", "Intelligent and secure systems", "Exploring how AI, software engineering and cybersecurity principles can be combined in reliable solutions."],
  ["02 / Backend & Data", "Structured software and databases", "Designing backend functionality, relational data models and maintainable integrations."],
  ["03 / Web Platforms", "Useful digital experiences", "Building web platforms that support real users and practical organisational workflows."],
];
---
<BaseLayout><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Software / AI / Cybersecurity</p><h1>Designing reliable systems with <span class="accent">care and curiosity.</span></h1><p class="lead">I am Riccardo Paravano, a Computer Science graduate and MSc student in Artificial Intelligence and Cybersecurity. I design dependable software, data-driven systems and web platforms by turning complex requirements into clear, maintainable solutions.</p><div class="button-row"><a class="button button--primary" href={withBase("/projects/")}>Explore my work</a><a class="button" href={withBase(siteConfig.cvPath)} download>Download CV</a><a class="text-link" href={withBase("/about/")}>More about me</a></div></div><aside class="panel" aria-label="Current professional focus"><span class="availability">Open to opportunities</span><p class="eyebrow">Current focus</p><dl><div><dt>Programme</dt><dd>MSc in AI &amp; Cybersecurity</dd></div><div><dt>Based in</dt><dd>Udine, Italy</dd></div><div><dt>Core areas</dt><dd>Software, data and web platforms</dd></div><div><dt>Approach</dt><dd>Precise, methodical and creative</dd></div></dl></aside></div></section><section class="section"><div class="container"><p class="eyebrow">Technical direction</p><h2>Where I create value</h2><div class="grid grid--three">{areas.map((area) => <article class="card"><p class="card__label">{area[0]}</p><h3>{area[1]}</h3><p class="card__text">{area[2]}</p></article>)}</div></div></section><section class="section"><div class="container callout"><div><p class="eyebrow">Selected work</p><h2>Experience through real projects.</h2></div><a class="button button--primary" href={withBase("/projects/")}>View projects</a></div></section></BaseLayout>
<style>
.hero { display: grid; min-height: calc(100svh - 4.75rem); align-items: center; padding: clamp(4rem, 8vw, 7rem) 0; }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(19rem, .65fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
.panel,.callout { padding: clamp(1.5rem,4vw,3rem); border: 1px solid var(--border); border-radius: 1.5rem; background: linear-gradient(145deg, rgba(142,197,244,.055), transparent 42%), var(--surface); box-shadow: 0 24px 70px rgba(0,0,0,.24); }
.availability { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 1.7rem; color: #9ce7bd; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.availability::before { width: .55rem; height: .55rem; border-radius: 50%; background: #5ee0a0; box-shadow: 0 0 0 .3rem rgba(94,224,160,.12); content: ""; }
dl, dd { margin: 0; } dl { display: grid; gap: 1.15rem; } dl div { padding-bottom: 1.05rem; border-bottom: 1px solid var(--border); } dl div:last-child { padding-bottom: 0; border-bottom: 0; } dt { margin-bottom: .2rem; color: var(--muted); font-size: .78rem; } dd { font-weight: 720; }
.callout { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }.callout h2 { margin: 0; }.text-link { display: inline-flex; min-height: 3rem; align-items: center; padding-inline: .35rem; color: var(--muted); font-weight: 750; text-underline-offset: .3rem; }.text-link:hover { color: var(--accent); }
@media (max-width: 920px) { .hero-grid { grid-template-columns: 1fr; } .panel { max-width: 38rem; } }
@media (max-width: 820px) { .callout { align-items: start; flex-direction: column; } }
</style>