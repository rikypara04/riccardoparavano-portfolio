---
import BaseLayout from "../layouts/BaseLayout.astro";

const education = [
  {
    place: "Università degli Studi di Udine",
    qualification: "MSc in Cyber Security and Artificial Intelligence",
    period: "2026 – present",
    detail: "Current graduate studies focused on the intersection of secure systems, computer science and artificial intelligence.",
  },
  {
    place: "Università degli Studi di Udine",
    qualification: "BSc in Computer Science",
    period: "September 2023 – July 2026",
    detail: "Bachelor's degree in Informatics, completed in 2026.",
  },
  {
    place: "University of Ljubljana · Faculty of Computer and Information Science",
    qualification: "Erasmus+ Exchange Programme",
    period: "September 2025 – February 2026",
    detail: "International academic experience in a European computer science environment.",
  },
  {
    place: "University of Gothenburg",
    qualification: "Erasmus+ Exchange Programme",
    period: "August 2024 – January 2025",
    detail: "First international study experience, strengthening independence and collaboration in an international setting.",
  },
];

const experience = [
  {
    organisation: "PAT Srl · Zucchetti Group",
    role: "Software Developer Intern",
    period: "March 2026 – July 2026 · Tavagnacco, Italy",
    detail: "Curricular internship focused on a threshold-based predictive maintenance module for openMAINT. Activities included requirements analysis, relational database design, PostgreSQL implementation, Java/Groovy backend development, JavaScript frontend work, platform integration and functional testing.",
  },
  {
    organisation: "A.I.A. · Associazione Italiana Arbitri, FIGC",
    role: "Football Referee",
    period: "October 2022 – present · Udine, Italy",
    detail: "Management of football matches, application of regulations, communication with players and staff, conflict management and decision-making under pressure.",
  },
  {
    organisation: "Croce Rossa Italiana",
    role: "Volunteer TSSA Operator",
    period: "July 2024 – present · Udine, Italy",
    detail: "Support in emergency assistance and patient transport, working with teams and communicating responsibly with patients and families.",
  },
];

const otherActivities = [
  {
    title: "Rotary Youth Leadership Awards (RYLA) · 43rd edition",
    period: "February – March 2026 · Rotary District 2060",
    description: "Leadership programme including teamwork on a country profile, negotiation exercises, public speaking and strategic analysis in collaboration with CESMAR.",
  },
];

const skills = [
  ["Programming", "Java · Groovy · JavaScript · PHP · SQL · PL/pgSQL"],
  ["Databases", "PostgreSQL · MySQL · Relational modelling · ER diagrams"],
  ["Platforms and tools", "openMAINT · CMDBuild · Waterway · WordPress · Astro · TypeScript"],
  ["Engineering practices", "Requirements analysis · Integration · Functional testing · Technical documentation"],
];
---
<BaseLayout
  title="About | Riccardo Paravano"
  description="Education, software development experience and international background of Riccardo Paravano."
>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">About me</p>
      <h1>Computer science, practical engineering and an international outlook.</h1>
      <p class="lead">I am a Computer Science graduate from the University of Udine, currently pursuing an MSc in Cyber Security and Artificial Intelligence. My first professional experience gave me the opportunity to work on enterprise software, while personal and international experiences have strengthened my sense of responsibility, adaptability and collaboration.</p>
    </header>

    <section class="content-section">
      <div class="section-heading"><p class="eyebrow">Education</p><h2>Academic background</h2></div>
      <div class="timeline">
        {education.map((item) => (
          <article class="timeline-item">
            <div class="timeline-period">{item.period}</div>
            <div><h3>{item.qualification}</h3><p class="organisation">{item.place}</p><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading"><p class="eyebrow">Experience</p><h2>Professional and community roles</h2></div>
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item">
            <div class="timeline-period">{item.period}</div>
            <div><p class="organisation">{item.organisation}</p><h3>{item.role}</h3><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading"><p class="eyebrow">Leadership and development</p><h2>Learning beyond the classroom</h2></div>
      <div class="activity-grid">
        {otherActivities.map((item) => (
          <article class="card"><p class="card__label">{item.period}</p><h3>{item.title}</h3><p class="card__text">{item.description}</p></article>
        ))}
        <article class="card"><p class="card__label">International experience</p><h3>Gothenburg and Ljubljana</h3><p class="card__text">Two Erasmus+ experiences gave me the opportunity to study in different academic environments, collaborate with international peers and become more independent.</p></article>
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading"><p class="eyebrow">Technical toolkit</p><h2>Technologies and practices</h2></div>
      <p class="section-note">A selection of technologies used in projects and academic work. The depth of experience varies by tool; the project case studies provide the practical context.</p>
      <div class="skills-grid">
        {skills.map((item) => <article class="skill-card"><h3>{item[0]}</h3><p>{item[1]}</p></article>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .content-section { padding: 3.5rem 0; border-top: 1px solid var(--border); }
  .section-heading { margin-bottom: 2rem; }
  .section-heading .eyebrow { margin-bottom: .65rem; }
  .section-heading h2 { margin-bottom: 0; }
  .timeline { display: grid; gap: 0; }
  .timeline-item { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 2rem; padding: 1.7rem 0; border-top: 1px solid var(--border); }
  .timeline-item:first-child { border-top: 0; }
  .timeline-period { color: var(--accent); font-size: .85rem; font-weight: 750; }
  .timeline-item h3 { margin: .25rem 0 .5rem; font-size: 1.35rem; }
  .timeline-item p { max-width: 72ch; margin-bottom: 0; color: var(--muted); }
  .timeline-item .organisation { margin-bottom: .45rem; color: var(--text); font-weight: 750; }
  .activity-grid, .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .activity-grid .card, .skill-card { height: 100%; }
  .skill-card { padding: 1.4rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .skill-card h3 { margin-bottom: .6rem; }
  .skill-card p, .section-note { margin-bottom: 0; color: var(--muted); }
  .section-note { max-width: 70ch; margin-bottom: 1.5rem; }
  @media (max-width: 720px) { .timeline-item { grid-template-columns: 1fr; gap: .6rem; } .activity-grid, .skills-grid { grid-template-columns: 1fr; } }
</style>
