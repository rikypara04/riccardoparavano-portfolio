---
import { siteConfig } from "../config/site";
---
<footer><div class="container footer"><div><strong>{siteConfig.name}</strong><p>Software development, AI, cybersecurity and reliable web platforms.</p></div><div class="meta"><div class="socials"><a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a><a href={siteConfig.linkedin} target="_blank" rel="noreferrer">LinkedIn</a><a href={`mailto:${siteConfig.email}`}>Email</a></div><span>{siteConfig.location}</span><span>&copy; {new Date().getFullYear()} {siteConfig.name}</span></div></div></footer>
<style>
footer { padding: 2.5rem 0; border-top: 1px solid var(--border); background: #0b1220; }
.footer { display: flex; justify-content: space-between; gap: 2rem; }
p { margin: .35rem 0 0; color: var(--muted); }.meta { display: grid; justify-items: end; gap: .3rem; color: var(--muted); font-size: .9rem; }.socials { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 1rem; }.socials a { color: var(--text); font-weight: 700; text-underline-offset: .25rem; }.socials a:hover { color: var(--accent); }
@media (max-width: 700px) { .footer { flex-direction: column; } .meta { justify-items: start; } .socials { justify-content: flex-start; } }
</style>