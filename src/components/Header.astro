---
import { withBase } from "../utils/url";
const currentPath = Astro.url.pathname;
const navigation = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/contact/", label: "Contact" },
];
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={withBase("/")} aria-label="Riccardo Paravano, homepage"><b>RP</b><span>Riccardo Paravano</span></a>
    <nav aria-label="Primary navigation"><ul>{navigation.map((item) => <li><a href={withBase(item.href)} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a></li>)}</ul></nav>
  </div>
</header>
<style>
.site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid var(--border); background: rgba(7,11,20,.9); backdrop-filter: blur(18px); }
.inner { display: flex; min-height: 4.75rem; align-items: center; justify-content: space-between; gap: 1rem; }
.brand { display: flex; align-items: center; gap: .7rem; font-weight: 850; text-decoration: none; }
.brand b { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: .55rem; color: #06111c; background: var(--accent); font-size: .78rem; }
ul { display: flex; gap: .25rem; padding: 0; margin: 0; list-style: none; }
nav a { display: block; padding: .55rem .75rem; border-radius: .45rem; color: var(--muted); font-size: .92rem; font-weight: 700; text-decoration: none; }
nav a:hover, nav a[aria-current="page"] { color: var(--text); background: rgba(142,197,244,.12); }
@media (max-width: 640px) { .brand span { display: none; } nav a { padding-inline: .5rem; font-size: .84rem; } }
</style>